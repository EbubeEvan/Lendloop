# Backend environment variables for the Convex deployment.
# Copy to .env.convex.local and run:
#   pnpm exec convex env set --from-file .env.convex.local
# These values are NOT readable by the browser.

# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Comma-separated emails that are promoted to admin on sign-in.
# The Convex users table remains the source of truth after promotion.
ADMIN_EMAILS=you@example.com

# Shared HMAC secrets. Generate with: openssl rand -hex 32
# Convex → n8n webhook (outgoing request notifications)
CONVEX_TO_N8N_SECRET=replace-me-with-64-hex-chars
# n8n → Convex HTTP endpoints (overdue fetch, reminder write-back, failures)
N8N_TO_CONVEX_SECRET=replace-me-with-64-hex-chars

# Public webhook endpoint exposed by n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-events

# Allow the demo seed mutation in local development only
ALLOW_DEV_SEED=true
