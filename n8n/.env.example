# ─── n8n runtime ──────────────────────────────────────────────────────────────
# Copy to n8n/.env. Generate the encryption key with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-me-32-bytes
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
TZ=UTC

# Allow workflow expressions to read $env (needed for HMAC secrets + URLs).
# Secrets live here, never in workflow JSON.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# The Code nodes use Node's crypto module for HMAC.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Where email links point.
APP_URL=http://localhost:3000

# ─── LendLoop integration secrets ─────────────────────────────────────────────
# Must match the values pushed to Convex. Use the SAME random hex strings.
CONVEX_TO_N8N_SECRET=replace-me-with-64-hex-chars
N8N_TO_CONVEX_SECRET=replace-me-with-64-hex-chars
CONVEX_SITE_URL=http://host.docker.internal:3210

# ─── Local email (Mailpit) ────────────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lendloop@example.test

# ─── n8n database ─────────────────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-local-password
POSTGRES_DB=n8n
