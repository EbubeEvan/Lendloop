# Accounts for the signed-in Playwright flows (pnpm test:e2e:flows).
# Copy to .env.e2e.local. Create these users in your Clerk *development*
# instance first; the suite signs in with Clerk sign-in tickets, so no
# passwords are needed. Clerk and Convex keys are read from .env.local.

E2E_OWNER_EMAIL=owner+clerk_test@example.com
E2E_BORROWER_EMAIL=borrower+clerk_test@example.com

# Optional: enables the admin specs. Must also be listed in the Convex
# deployment's ADMIN_EMAILS.
E2E_ADMIN_EMAIL=admin+clerk_test@example.com
