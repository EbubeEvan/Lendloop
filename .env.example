# ─── Next.js / Clerk (client + server) ────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex dev deployment URL (printed by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional Clerk routing overrides
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/browse
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/browse

# ─── Backend-only values (also push these to Convex) ──────────────────────────
# See .env.convex.example. Use `pnpm exec convex env set --from-file .env.convex.local`.
ALLOW_DEV_SEED=false
